{
  "manifest_version": 3,
  "minimum_chrome_version": "140",
  "name": "Pixel Jukebox",
  "description": "Game Boy-inspired YouTube music player with playlists and optional AI picks.",
  "version": "0.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "debugger"],
  "content_scripts": [{ "matches": ["https://www.youtube.com/embed/*"], "js": ["youtube-controls-v3.js"], "all_frames": true, "run_at": "document_idle" }],
  "optional_host_permissions": ["https://api.openai.com/*", "https://www.youtube.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Pixel Jukebox 열기",
    "default_popup": "sidepanel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://seoheejung.github.io; img-src 'self' https://i.ytimg.com data:"
  }
}
