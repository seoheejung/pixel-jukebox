{
  "name": "pixel-jukebox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bridge": "node --check player-bridge/player.js",
    "check:manifest": "node scripts/check-manifest.mjs",
    "chrome:start": "node scripts/start-chrome.mjs",
    "chrome:stop": "node scripts/stop-chrome.mjs",
    "test:chrome:bridge": "node scripts/test-chrome-player-bridge.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
